{
  "name": "express-pickup",
  "private": true,
  "version": "1.0.0",
  "description": "Express Pick-Up: предзаказ еды к точному времени без регистрации",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\"",
    "test": "node --test tests/backend.test.js tests/time.test.js tests/dayRollover.test.js tests/staffAccess.test.js tests/i18n.test.js tests/locations.test.js tests/geo.test.js tests/favorites.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.js\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.0.0",
    "firebase": "^10.12.2",
    "framer-motion": "^11.2.10",
    "leaflet": "^1.9.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.24.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "postcss": "^8.4.38",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.1",
    "vite-plugin-pwa": "^0.20.0"
  }
}

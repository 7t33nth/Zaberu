rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Сотрудник считается "своим" для заведения restaurantId, если его документ
    // staff/{email} существует и содержит этот id (или "*" — доступ ко всем).
    // ВАЖНО: без этой проверки любой залогиненный сотрудник ЛЮБОГО одного заведения
    // мог бы через list/update видеть и менять заказы ЧУЖИХ заведений — именно
    // это и было дырой, которую эта функция закрывает.
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email.lower()));
    }
    function isStaffFor(restaurantId) {
      return request.auth != null
             && request.auth.token.email != null
             && staffDoc().data.restaurantIds.hasAny([restaurantId, '*']);
    }

    // Документ дня называется days/{restaurantId}_{yyyymmdd} (см. dayRef в
    // lib/backends/firebase.js), причём ни id заведения, ни дата не содержат "_" —
    // поэтому заведение дня однозначно восстанавливается из id до первого подчёркивания.
    function dayRestaurantId(dayId) {
      return dayId.split('_')[0];
    }
    // Оформить заказ умеет анонимный клиент, поэтому и запись в days открыта без входа.
    // Вошедшему сотруднику — только в дни своего заведения: счётчик чужой кухни он не
    // сломает даже случайно. Побочный эффект: если в том же браузере открыта кухня, заказ
    // из клиентской части пройдёт только в своём заведении (для демо это приемлемо).
    function isDayWriter(dayId) {
      return request.auth == null || isStaffFor(dayRestaurantId(dayId));
    }

    // Заказы: клиент создаёт заказ и читает его по id (без входа),
    // кухня (авторизованный сотрудник СВОЕГО заведения) видит список и меняет статус.
    match /orders/{orderId} {
      allow get: if true;
      // Список нужен только экрану кухни. Клиент обязан фильтровать запрос по
      // restaurantId (см. subscribeOrders в lib/backends/firebase.js) — иначе Firestore
      // не сможет доказать, что список ограничен только "своими" документами, и отклонит запрос.
      allow list: if isStaffFor(resource.data.restaurantId);
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.restaurantId is string
                    && request.resource.data.pickupAt is int
                    && request.resource.data.units is int
                    && request.resource.data.units > 0
                    && request.resource.data.units <= 30
                    // Начальные статусные поля нельзя подделать при создании — их
                    // выставляет только кухня/клиент отдельными разрешёнными update-ами.
                    && !('readyAt' in request.resource.data)
                    && !('arrivedAt' in request.resource.data)
                    && !('receivedAt' in request.resource.data)
                    && !('issuedAt' in request.resource.data);
      // Клиент без входа может: 1) отметить своё прибытие (arrivedAt, таймстамп);
      // 2) подтвердить получение готового заказа (receivedAt) — без этого кухня не может
      // закрыть заказ в одностороннем порядке; 3) отменить СВЕЖИЙ (ещё 'pending') заказ
      // в течение 1 минуты после создания — окно намеренно короткое, чтобы это не
      // превращалось в лазейку для отмены уже готовящихся заказов. Статус заказа
      // (готово/выдано) меняет только вошедший сотрудник СВОЕГО заведения.
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arrivedAt'])
                         && request.resource.data.arrivedAt is int)
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedAt'])
                        && request.resource.data.receivedAt is int
                        && resource.data.status == 'ready')
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                        && request.resource.data.status == 'cancelled'
                        && resource.data.status == 'pending'
                        && request.time.toMillis() < resource.data.createdAt + 60000)
                    // «Выдано» — только после подтверждения клиента. Если клиент не
                    // ответил за 3 часа после заявленного времени, подтверждение
                    // считается автоматическим (10800000 = RECEIVE_GRACE_MS в lib/time.js).
                    || (isStaffFor(resource.data.restaurantId)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'readyAt', 'arrivedAt', 'issuedAt'])
                        && (request.resource.data.status != 'done'
                            || resource.data.receivedAt != null
                            || request.time.toMillis() >= resource.data.pickupAt + 10800000));
      allow delete: if false;
    }

    // Занятость слотов и счётчик номеров: меняется транзакцией из приложения при
    // оформлении заказа (клиент без входа) и при отмене. Закрыть запись совсем нельзя —
    // заказ оформляет анонимный клиент, а счётчик слотов лежит в том же документе, — поэтому
    // правила ограничивают форму и масштаб записи, а не личность:
    //
    //  * создать документ дня можно только с seq = 1 и ровно одним слотом (первый заказ);
    //  * при обновлении seq не меняется или растёт ровно на 1 (так его двигает placeOrder),
    //    а в слотах за одну запись добавляется/меняется не больше одного ключа и ни один
    //    не удаляется — «обнулить все слоты» или переписать карту целиком уже нельзя;
    //  * удалить документ дня нельзя;
    //  * вошедший сотрудник пишет только в дни своего заведения.
    //
    // Остаточный риск: правила не умеют перебирать ключи карты, поэтому подменить значение
    // ОДНОГО слота (или положить туда мусор вместо числа) по-прежнему можно — по одной
    // записи за раз, и это не исправить на клиенте: нужна серверная проверка (Cloud
    // Function), вне рамок демо.
    match /days/{dayId} {
      allow read: if true;

      allow create: if isDayWriter(dayId)
                    && request.resource.data.keys().hasOnly(['seq', 'slots'])
                    && request.resource.data.seq == 1
                    && request.resource.data.slots is map
                    && request.resource.data.slots.keys().size() == 1;

      allow update: if isDayWriter(dayId)
                    && request.resource.data.keys().hasOnly(['seq', 'slots'])
                    && request.resource.data.seq is int
                    && (request.resource.data.seq == resource.data.seq
                        || request.resource.data.seq == resource.data.seq + 1)
                    && request.resource.data.slots is map
                    && resource.data.slots is map
                    // removedKeys() пуст — ни один слот нельзя удалить; affectedKeys() —
                    // это добавленные + изменённые + удалённые, значит меняется максимум один.
                    && request.resource.data.slots.diff(resource.data.slots).removedKeys().size() == 0
                    && request.resource.data.slots.diff(resource.data.slots).affectedKeys().size() <= 1;

      allow delete: if false;
    }

    // Привязка сотрудника (по email из Firebase Auth) к заведению(-ям).
    // Документ заводится вручную в консоли Firebase, id документа — email в нижнем регистре:
    // { restaurantIds: ["r01"] } или { restaurantIds: ["*"] } для доступа ко всем заведениям.
    match /staff/{staffId} {
      allow get: if request.auth != null
                 && request.auth.token.email != null
                 && request.auth.token.email.lower() == staffId;
      allow write: if false;
    }
  }
}
